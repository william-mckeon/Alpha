# Arcus — environment template. Copy to `.env` and edit. `.env` is gitignored.

# Tokenizer encoding. cl100k_base is the default (lighter, boenet's BPE); o200k_base
# (~200k) is available for scale-up where the larger vocab's cost is negligible.
ARCUS_ENCODING=cl100k_base

# MoD target capacity (fraction of tokens reaching the experts), in (0, 1].
ARCUS_CAPACITY=0.5

# Root of the alpha-dataset *.jsonl.zst shards.
ARCUS_SHARDS=./alpha dataset

CUDA_VISIBLE_DEVICES=0
PYTHONUNBUFFERED=1
