# Arcus — environment template. Copy to `.env` and edit. `.env` is gitignored.

# Evaluation credentials. Never put these in benchmark configs or image layers.
OPENROUTER_API_KEY=
TAVILY_API_KEY=

# Tokenizer encoding. cl100k_base is the default (lighter, boenet's BPE); o200k_base
# (~200k) is available for scale-up where the larger vocab's cost is negligible.
ARCUS_ENCODING=cl100k_base

# MoD target capacity (fraction of tokens reaching the experts), in (0, 1].
ARCUS_CAPACITY=0.5

# Root of the alpha-dataset *.jsonl.zst shards.
ARCUS_SHARDS=./alpha dataset

CUDA_VISIBLE_DEVICES=0
PYTHONUNBUFFERED=1

# Optional embodied visual workers. Leave unset for isolated local child workers.
# ARCUS_VISUAL_URL=http://127.0.0.1:8896
# ARCUS_NAVIGATION_URL=http://127.0.0.1:8897
# ARCUS_VISUAL_TOKEN=provide-a-private-service-token
# For compose.visual.yaml, select a qualified adapter directory and configuration.
# ARCUS_VISUAL_CONFIG=../../configs/baby_arcus/visual_navigation.container.json
