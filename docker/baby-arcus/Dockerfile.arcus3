# Before build, verify this local tag against local_runtime.json base_image_id.
FROM arcus-foundation:nanotron-v1
WORKDIR /app
COPY docker/baby-arcus/requirements.arcus3.txt /tmp/requirements.arcus3.txt
RUN python3 -m pip install --no-cache-dir -r /tmp/requirements.arcus3.txt
COPY arcus3 /app/arcus3
COPY scripts/*arcus3*.py /app/scripts/
COPY baby_arcus/gpu_job_control.py baby_arcus/process_lock.py /app/baby_arcus/
COPY scripts/probe_arcus3_donor.py /app/scripts/probe_arcus3_donor.py
COPY scripts/publish_alpha_3.py /app/scripts/publish_alpha_3.py
COPY scripts/verify_alpha_3.py /app/scripts/verify_alpha_3.py
COPY scripts/package_alpha_3.py /app/scripts/package_alpha_3.py
COPY docs/ALPHA_3_MODEL_CARD.md /app/docs/ALPHA_3_MODEL_CARD.md
COPY LICENSE NOTICE /app/
COPY scripts/qualify_arcus3_training.py /app/scripts/qualify_arcus3_training.py
COPY scripts/train_arcus3_specialization.py /app/scripts/train_arcus3_specialization.py
COPY scripts/report_arcus3_specialization.py /app/scripts/report_arcus3_specialization.py
COPY scripts/verify_arcus3_depth.py /app/scripts/verify_arcus3_depth.py
COPY scripts/convert_arcus3.py /app/scripts/convert_arcus3.py
COPY scripts/verify_arcus3_conversion.py /app/scripts/verify_arcus3_conversion.py
COPY scripts/train_arcus3.py /app/scripts/train_arcus3.py
COPY scripts/benchmark_arcus3.py /app/scripts/benchmark_arcus3.py
COPY scripts/chat_arcus3.py /app/scripts/chat_arcus3.py
COPY scripts/evaluate_arcus3.py /app/scripts/evaluate_arcus3.py
COPY scripts/report_arcus3.py /app/scripts/report_arcus3.py
COPY evaluation/arcus3 /app/evaluation/arcus3
COPY evaluation/alpha_developmental /app/evaluation/alpha_developmental
COPY baby_arcus/developmental_tasks.py /app/baby_arcus/developmental_tasks.py
COPY baby_arcus/language_stream.py /app/baby_arcus/language_stream.py
COPY configs/arcus3 /app/configs/arcus3
COPY tests/arcus3 /app/tests/arcus3
ENV PYTHONPATH=/app HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 PYTHONUNBUFFERED=1
ENV OMP_NUM_THREADS=2 MKL_NUM_THREADS=2 TOKENIZERS_PARALLELISM=false
ENTRYPOINT ["python3"]
