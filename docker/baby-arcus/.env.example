# Copy to an untracked .env and choose a private local service token.
# Do not publish these HTTP services directly to the internet.
BABY_ARCUS_TOKEN=
# Host ports can differ for a separately restored project; service DNS/ports stay fixed.
BABY_SIMULATION_PORT=8765
BABY_ARTIFACTS_PORT=8766
BABY_INFERENCE_PORT=8767
BABY_TRAINING_PORT=8768
BABY_CONTROLLER_PORT=8769
BABY_EVALUATOR_PORT=8770
BABY_DASHBOARD_PORT=8771

# Alpha three-stage deployment. Place actual values in the root .env; never commit secrets.
ALPHA_THREE_STAGE_RUN=
ALPHA_REVIEW_ROOT=
ARCUS_TEST2_DATASET=
ARCUS_TEST2_TOKEN=
ALPHA_REVIEW_TOKEN=
ALPHA_INGEST_TOKEN=
ALPHA_EXECUTOR_TOKEN=
ALPHA_PARENT_ROOT=
ALPHA_SERVICE_IMAGE=arcus-alpha-three-stage:local
ALPHA_GPU_MODE=qualified
# Explicit alternative: controlled-docker checks actual cgroup v2 limits and container
# identity, without asserting hardware clearance. It does not approve training data.
ALPHA_EXECUTOR_IMAGE=arcus-alpha-executor:qualification

# Phase 2: keep every attempt in a new host directory. Never mount the release writable.
# ALPHA_PARENT_ROOT=C:/.../runs/test2/alpha-idle-fresh-release-20260923
# ALPHA_THREE_STAGE_RUN=C:/.../runs/test2/alpha-phase2-attempt-001
# ALPHA_SFT_ROOT=C:/.../OpenCode/train/dataset
# ALPHA_QUALIFICATION_ROOT=C:/.../runs/diagnostics/qualification
# ALPHA_RUNTIME_IMAGE=sha256:<exact docker image ID>
# ALPHA_HOST_FINGERPRINT=<from collect_alpha_host_diagnostics.ps1>
# qualification/host.json is reviewed remediation evidence, not diagnostics alone.
# qualification/gpu.json is the bounded smoke report; both expire after 24 hours.
# Startup and job launch also check Docker VM headroom and competing GPU containers.
# Source-derived literal drills are review candidates, not original repository solutions.
