BABY_SIMULATION_PORT=8765
BABY_ARTIFACTS_PORT=8766
BABY_INFERENCE_PORT=8767
BABY_TRAINING_PORT=8768
BABY_CONTROLLER_PORT=8769
BABY_EVALUATOR_PORT=8770
BABY_DASHBOARD_PORT=8771
