# Default is the same explicit Linux/CUDA family as the existing GPU services.
ARG ARCUS_GPU_RUNTIME=nvidia/cuda:12.8.0-cudnn-runtime-ubuntu22.04@sha256:dab70d0872e15703b3ac7617471206902f6972007a9f514ca2eab8476863fbfd
FROM ${ARCUS_GPU_RUNTIME}
USER root
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 TIKTOKEN_CACHE_DIR=/opt/tiktoken
RUN if ! python3 -m pip --version >/dev/null 2>&1; then apt-get update && apt-get install -y --no-install-recommends python3 python3-pip ca-certificates && rm -rf /var/lib/apt/lists/*; fi
WORKDIR /app
COPY requirements-baby-arcus.txt requirements-baby-arcus.lock requirements-language.lock /app/
RUN python3 -c "import torch; assert torch.__version__.startswith('2.11.0')" || python3 -m pip install --no-cache-dir torch==2.11.0 --index-url https://download.pytorch.org/whl/cu128
RUN python3 -m pip install --no-cache-dir -r requirements-baby-arcus.txt -r requirements-language.lock && python3 -m pip check
RUN python3 -c "import tiktoken; tiktoken.get_encoding('o200k_base')" && chmod -R a+rX /opt/tiktoken
COPY arcus /app/arcus
COPY baby_arcus /app/baby_arcus
COPY configs/baby_arcus/language.container.json /app/config.json
COPY tests/baby_arcus/test_language.py /app/test_language.py
RUN (id baby >/dev/null 2>&1 || useradd --uid 10001 --create-home baby) && mkdir -p /state && chown baby:baby /state
USER baby
ENTRYPOINT ["python3","-m","baby_arcus.services.language_worker"]
CMD ["--config","/app/config.json","--host","0.0.0.0","--port","8895"]
