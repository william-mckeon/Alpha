ARG ARCUS_GPU_RUNTIME=nvidia/cuda:12.8.0-cudnn-runtime-ubuntu22.04@sha256:dab70d0872e15703b3ac7617471206902f6972007a9f514ca2eab8476863fbfd
FROM ${ARCUS_GPU_RUNTIME}
USER root
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 LANGSMITH_TRACING=false
RUN if ! python3 -m pip --version >/dev/null 2>&1; then apt-get update && apt-get install -y --no-install-recommends python3 python3-pip ca-certificates && rm -rf /var/lib/apt/lists/*; fi
WORKDIR /app
COPY requirements-baby-arcus.txt requirements-baby-arcus.lock requirements-language.lock requirements-visual.lock /app/
RUN python3 -c "import torch; assert torch.__version__.startswith('2.11.0')" || python3 -m pip install --no-cache-dir torch==2.11.0 --index-url https://download.pytorch.org/whl/cu128
RUN python3 -m pip install --no-cache-dir -r requirements-baby-arcus.txt -r requirements-visual.lock && python3 -m pip check
COPY requirements-test2.lock /app/
RUN python3 -m pip install --no-cache-dir -r requirements-test2.lock && python3 -m pip check
ENV ALPHA_RUNTIME_PROFILE=alpha-container-v1
ENV TIKTOKEN_CACHE_DIR=/opt/arcus-tokenizer-cache
RUN mkdir -p /opt/arcus-tokenizer-cache && python3 -c "import tiktoken; tiktoken.get_encoding('o200k_base')" && chmod -R a+rX /opt/arcus-tokenizer-cache
RUN python3 -c "import sys; assert sys.version_info[:2] == (3,10); assert '22.04' in open('/etc/os-release').read()"
COPY arcus /app/arcus
COPY baby_arcus /app/baby_arcus
COPY configs /app/configs
COPY scripts /app/scripts
COPY tests /app/tests
RUN (id -u experiment >/dev/null 2>&1 || useradd --uid 10002 --create-home experiment) && mkdir -p /app/runs/test2 /control && chown -R experiment /app/runs /control
USER experiment
ENTRYPOINT ["python3"]
CMD ["-m","baby_arcus.services.shared_trainer","--host","0.0.0.0"]
