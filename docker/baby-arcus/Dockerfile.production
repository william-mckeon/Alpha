FROM arcus3:phase8-context-v6
USER root
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
USER experiment
WORKDIR /app
RUN python3 -m pip install --no-cache-dir 'setuptools==70.3.0' wheel
# Keep the qualified Blackwell-compatible Torch. Upstream's torch<2.5 cannot run this GPU.
RUN python3 -m pip install --no-cache-dir --no-build-isolation --no-deps 'lighteval @ https://github.com/huggingface/lighteval/archive/ea46419a93fb390e8f694f7c6c64c1e684487c9d.zip'
RUN python3 -m pip install --no-cache-dir word2number GitPython termcolor==2.3.0 pytablewriter colorama aenum==3.1.15 nltk==3.9.1 scikit-learn spacy==3.7.2 sacrebleu rouge_score==0.1.2 sentencepiece pycountry langdetect datasets==2.21.0 protobuf==3.20.3 openai==1.51.0 zstandard
COPY arcus3 /app/arcus3
COPY scripts/*arcus3*.py /app/scripts/
RUN python3 /app/scripts/patch_arcus3_lighteval_runtime.py
RUN python3 -c "import nltk; nltk.download('punkt',raise_on_error=True); nltk.download('punkt_tab',raise_on_error=True)"
COPY tests/arcus3 /app/tests/arcus3
COPY configs/arcus3/production.json /app/configs/arcus3/production.json
COPY vendor/smollm2 /app/vendor/smollm2
ENV PYTHONPATH=/app:/app/vendor/smollm2
