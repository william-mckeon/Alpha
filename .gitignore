.sm_src/

# --- Data + HuggingFace / tokenizer caches ---
data/
.hf_cache/
.cache/

# --- Alpha dataset shards (multi-GB; built by DatasetForge, never committed) ---
alpha dataset/**/*.zst
alpha dataset/**/*.jsonl
alpha dataset/.datasetforge_state.json

# --- OS ---
.DS_Store
Thumbs.db

# Local debugger symbol cache
symbols/

# Generated Hugging Face export copies; recreated by scripts/package_alpha_hf.py
artifacts/huggingface/
# Pinned donor downloads, partial transfers and generated Arcus 3 model artifacts.
artifacts/arcus3/
